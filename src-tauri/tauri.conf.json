{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Royal Multi Gamers Launcher",
  "version": "1.0.10",
  "identifier": "com.royalmultigamers.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Royal Multi Gamers Launcher",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#08090b",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQkY0RDQ2ODkwNEZEMTAKUldRUS9RU0pSazIvY1FFanlCdXVycnhyOEM5UGdPcllPeEFENW44Z0o3T0o4RzZRaCtucXp5WXMK",
      "endpoints": [
        "https://github.com/Royal-Multi-Gamers/Royal-Multi-Gamers-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
